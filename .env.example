# Copy to .env in the repository root. Everything here is optional: without Gemini
# credentials, give orders with --part/--qty and pass --no-llm.

# Gemini, option 1: an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini, option 2: Vertex AI with a service account (leave GEMINI_API_KEY empty).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# GEMINI_MODEL=gemini-3.8-flash

# MQTT broker shared with the factory testbed.
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
