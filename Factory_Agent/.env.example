# Copy this file to `.env` (in the same folder) and fill in the values below.

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Absolute path to your GCP service-account key JSON file.
# Download it from Google Cloud Console -> IAM & Admin -> Service Accounts,
# save it as Factory_Agent/gcp-key.json (or anywhere else), and update this path.
# Windows tip: use forward slashes or double-backslashes, e.g.
#   C:/Users/you/projects/Google_ADK/Factory_Agent/gcp-key.json
GOOGLE_APPLICATION_CREDENTIALS=./Factory_Agent/gcp-key.json


# Optional: only needed if you want Telegram alerts.
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
TELEGRAM_SEVERITY_THRESHOLD=medium
TELEGRAM_ALERT_COOLDOWN_SEC=15
MONITOR_POLL_SECONDS=30
